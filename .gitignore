# ---------------------------------------------------------------------------
# Acrescentado ao herdar o projeto
# ---------------------------------------------------------------------------

# Caminhos do SDK, especificos de cada maquina. Foi este arquivo que veio
# apontando para o computador do dono anterior e impedia o projeto de
# compilar. Ele e regerado sozinho pelo `flutter build`.
android/local.properties
local.properties

# SEGREDOS: chaves de assinatura do app. Se vazarem, outra pessoa consegue
# publicar atualizacoes falsas em nome do seu app. Nunca subir.
*.jks
*.keystore
android/key.properties

# APKs gerados. Sao grandes e regeraveis; distribua por release do GitHub,
# nao versionando o binario.
*.apk
*.aab

# Gradle
android/.gradle/
.gradle/

# Resultado de compilacao em QUALQUER subpasta. A regra `/build/` la em cima
# so pega a pasta da raiz e deixava `android/build/` escapar para o commit.
**/build/


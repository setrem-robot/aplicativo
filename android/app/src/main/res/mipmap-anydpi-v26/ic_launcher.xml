<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone adaptativo (Android 8+). O sistema recorta a máscara que o fabricante
     escolheu — círculo, squircle, gota — sobre estas duas camadas, e só os 2/3
     centrais são garantidos. Por isso os olhos vão desenhados menores nesta
     camada do que no ic_launcher.png legado. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>

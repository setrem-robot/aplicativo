# Podfile do lado iOS.
#
# O Flutter gera este arquivo sozinho na primeira build feita num Mac, mas aí a
# versão mínima do iOS vem do padrão do template — e o `flutter_blue_plus` 2.x
# exige iOS 13. Fixar aqui evita descobrir isso no meio de uma build, na única
# máquina onde dá para compilar.

platform :ios, '13.0'

# CocoaPods analytics manda uma requisição de rede a cada build, o que atrasa o
# `pod install` sem devolver nada para este projeto.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # O `permission_handler` compila, por padrão, o código de TODAS as
      # permissões que ele sabe pedir — câmera, fotos, contatos, localização —
      # mesmo que o app nunca peça nenhuma delas. Isso incha o binário e, pior,
      # faz a revisão da App Store perguntar por que um app de controle de robô
      # toca em contatos e fotos.
      #
      # Este app só usa o `permission_handler` no Android: no iOS o Bluetooth é
      # pedido pelo próprio sistema, com a `NSBluetoothAlwaysUsageDescription`
      # do Info.plist, e BLE aqui não usa localização. Então tudo fica em 0.
      # Se um dia alguma permissão passar a ser pedida no iOS, ligue a linha
      # correspondente aqui **e** declare a chave de descrição no Info.plist —
      # pedir sem a chave derruba o app na hora.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_CONTACTS=0',
        'PERMISSION_CAMERA=0',
        'PERMISSION_MICROPHONE=0',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_PHOTOS=0',
        'PERMISSION_NOTIFICATIONS=0',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_CRITICAL_ALERTS=0',
        'PERMISSION_ASSISTANT=0',
        'PERMISSION_LOCATION=0',
      ]
    end
  end
end
